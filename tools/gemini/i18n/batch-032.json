[{"id":"s4380","ko":"정재"},{"id":"s4381","ko":"편관"},{"id":"s4382","ko":"정관"},{"id":"s4383","ko":"편인"},{"id":"s4384","ko":"정인"},{"id":"s4398","ko":"용용사주"},{"id":"s4399","ko":"용하디 용한 사주, 용용이가 봐 드려요\n생년월일만 넣으면 오늘의 운세와 고민 상담까지"},{"id":"s4401","ko":"홈"},{"id":"s4402","ko":"무료 사주 맛보기"},{"id":"s4403","ko":"관상 (사진으로 보기)"},{"id":"s4404","ko":"얼굴로 보는 관상"},{"id":"s4405","ko":"정면 사진 한 장이면 돼요. 사진은 내 기기 안에서만 분석하고 서버로 보내지 않아요."},{"id":"s4406","ko":"밝은 곳에서 정면으로"},{"id":"s4407","ko":"머리카락은 이마가 보이게 넘기기"},{"id":"s4408","ko":"안경·마스크·모자는 벗기"},{"id":"s4409","ko":"무표정에 가깝게"},{"id":"s4410","ko":"얼굴에서 점을 하나씩 찾는 중"},{"id":"s4411","ko":"눈 사이를 재어 기준을 잡는 중"},{"id":"s4412","ko":"다섯 기운의 비율을 읽는 중"},{"id":"s4413","ko":"이마 상단"},{"id":"s4414","ko":"눈썹 사이"},{"id":"s4415","ko":"코 아래"},{"id":"s4416","ko":"턱끝"},{"id":"s4417","ko":"오행 얼굴형"},{"id":"s4418","ko":"${e}의 성향이 함께 섞여 있어요. 한 가지 색으로만 설명되지 않는 얼굴이에요."},{"id":"s4419","ko":"내 관상 카드 공유하기"},{"id":"s4420","ko":"카드 이미지를 저장했어요. 친구에게 보내 보세요."},{"id":"s4421","ko":"사진을 올리기 전에 확인해 주세요"},{"id":"s4422","ko":"아래 내용에 모두 동의해요"},{"id":"s4423","ko":"분석이 오래 걸려요. 인터넷 연결을 확인하고 다시 시도해 주세요."},{"id":"s4424","ko":"사진은 이 기기 안에서만 분석하고, 서버로 보내거나 저장하지 않는다는 점을 확인했어요."},{"id":"s4425","ko":"내 사진이거나, 사진 속 사람의 허락을 받은 사진이에요. (만 14세 미만은 보호자 동의가 필요해요)"},{"id":"s4426","ko":"관상은 재미로 보는 경향 풀이이고, 성격·능력을 단정하지 않는다는 점을 알아요."},{"id":"s4427","ko":"동의하고 사진 고르기"},{"id":"s4428","ko":"취소"},{"id":"s4429","ko":"개인정보 처리방침"},{"id":"s4430","ko":"이용약관"},{"id":"s4431","ko":"돌아가기"},{"id":"s4432","ko":"카메라로 찍기"},{"id":"s4433","ko":"앨범에서 고르기"},{"id":"s4434","ko":"용용이가 얼굴을 살펴보는 중…"},{"id":"s4435","ko":"얼굴을 찾지 못했어요. 밝은 곳에서 정면으로 다시 찍어 주세요."},{"id":"s4436","ko":"얼굴이 여러 개 보여요. 한 사람만 나오게 찍어 주세요."},{"id":"s4437","ko":"얼굴이 옆으로 돌아가 있어요. 정면을 보고 다시 찍어 주세요."},{"id":"s4438","ko":"고개가 많이 기울었어요. 바르게 세우고 다시 찍어 주세요."},{"id":"s4439","ko":"정면을 바라보는 사진을 올려 주세요. (얼굴이 좌우 ${yw}°, 상하 ${pt}°, 기울기 ${rl}° 만큼 벗어나 있어요)"},{"id":"s4440","ko":"얼굴을 분석하고 있어요…"},{"id":"s4441","ko":"인상 특징을 읽고 있어요…"},{"id":"s4442","ko":"성향을 해석하고 있어요…"},{"id":"s4443","ko":"리포트를 작성하고 있어요…"},{"id":"s4444","ko":"분석에 실패했어요. 잠시 뒤 다시 시도해 주세요."},{"id":"s4445","ko":"다른 사진으로 다시 보기"},{"id":"s4446","ko":"사주도 같이 보기"},{"id":"s4447","ko":"사진은 저장되지 않아요. 이 화면을 닫으면 사라져요."},{"id":"s4448","ko":"종합 사주 리포트"},{"id":"s4449","ko":"내 사주를 12단계로 깊게 풀어 쓰는 상담서예요. 타고난 구조부터 평생 흐름, 돈·직업·연애·결혼·건강·가족, 대운과 중요한 해까지 한 번에 받아요."},{"id":"s4450","ko":"지금 상황 진단"},{"id":"s4451","ko":"원국 핵심 구조"},{"id":"s4452","ko":"평생 총운"},{"id":"s4453","ko":"금전운"},{"id":"s4454","ko":"직업운"},{"id":"s4455","ko":"연애·결혼운"},{"id":"s4456","ko":"건강·가족운"},{"id":"s4457","ko":"대운·세운 해석"},{"id":"s4458","ko":"현실 조언"},{"id":"s4459","ko":"말투"},{"id":"s4460","ko":"냉정한 전문가"},{"id":"s4461","ko":"따뜻한 상담가"},{"id":"s4462","ko":"AI 리포트 만들기"},{"id":"s4463","ko":"AI 리포트는 질문권이 있어야 만들 수 있어요. 결제는 준비 중이에요. 아래 방법으로는 지금 바로 무료로 받아볼 수 있어요."},{"id":"s4464","ko":"${n}/4 파트를 쓰는 중이에요. 파트마다 1분쯤 걸려요. 화면을 닫지 마세요."},{"id":"s4465","ko":"일부 파트를 만들지 못했어요. 만든 부분까지 보여 드려요."},{"id":"s4466","ko":"AI가 응답하지 않아 질문권은 쓰지 않았어요. 잠시 뒤 다시 해 주세요."},{"id":"s4467","ko":"내 AI(제미나이·챗GPT)에서 무료로 받기"},{"id":"s4468","ko":"계산 데이터가 들어간 지시문을 복사해서 제미나이나 챗GPT에 붙여 넣으세요. 1/4부터 순서대로, 같은 대화창에 이어 붙이면 돼요."},{"id":"s4469","ko":"${n}/4 복사"},{"id":"s4470","ko":"복사했어요. AI에 붙여 넣으세요."},{"id":"s4471","ko":"리포트는 사주 구조로 계산한 경향이에요. 건강·사건은 확정이 아니고, 재미와 참고로 봐 주세요. 중요한 결정은 스스로 판단해 주세요."},{"id":"s4472","ko":"올해"},{"id":"s4473","ko":"내년"},{"id":"s4474","ko":"연도"},{"id":"s4477","ko":"시"},{"id":"s4478","ko":"분"},{"id":"s4479","ko":"친구와 나누기"},{"id":"s4480","ko":"나도 다른 사람과 궁합 보기"},{"id":"s4481","ko":"친구에게 궁합 보내기"},{"id":"s4482","ko":"결과 카드 저장"},{"id":"s4483","ko":"링크에는 내 생년월일이 들어 있어요. 믿는 사람에게만 보내세요."},{"id":"s4484","ko":"링크를 복사했어요. 친구에게 붙여 넣어 보내세요."},{"id":"s4485","ko":"카드를 저장했어요."},{"id":"s4486","ko":"용용이가 본 우리 궁합은 ${sc}점, \"${hl}\"! 너랑도 궁합 볼래?"},{"id":"s4487","ko":"${n}님이 궁합을 보내왔어요"},{"id":"s4488","ko":"친구가 궁합을 보내왔어요"},{"id":"s4489","ko":"내 생년월일만 넣으면 둘의 궁합을 바로 볼 수 있어요. 가입은 필요 없어요."},{"id":"s4490","ko":"우리 궁합 보기"},{"id":"s4491","ko":"해외 인기"},{"id":"s4492","ko":"해외에선 이렇게 봐요"},{"id":"s4493","ko":"서양 별자리로 보는 내 성격. 생일만 넣으면 태양·달·상승 별자리를 풀어 드려요."},{"id":"s4494","ko":"별자리 맛보기"},{"id":"s4496","ko":"생일만 넣으면 돼요. 해외에서 가장 많이 보는 방식이에요."},{"id":"s4497","ko":"별자리 보기"},{"id":"s4498","ko":"내 사주도 보기"},{"id":"s4499","ko":"이름도 가입도 필요 없어요. 생일만 알려주면 용용이가 슬쩍 봐 줄게요!"},{"id":"s4500","ko":"무료 사주 보기"},{"id":"s4501","ko":"다시 입력"},{"id":"s4502","ko":"오늘의 운세"},{"id":"s4503","ko":"로그인하면 매일 열려요"},{"id":"s4504","ko":"베타 체험으로 열기"},{"id":"s4505","ko":"모든 운세 보기"},{"id":"s4506","ko":"용용이에게 물어보기"},{"id":"s4507","ko":"고민을 적으면 좋은 시기까지 짚어 드려요"},{"id":"s4508","ko":"질문하기"},{"id":"s4509","ko":"베타 기간 무료"},{"id":"s4511","ko":"시험 날 사주 (수능)"},{"id":"s4513","ko":"내 사주"},{"id":"s4514","ko":"고민 상담"},{"id":"s4515","ko":"궁합"},{"id":"s4516","ko":"풀이 목록"},{"id":"s4517","ko":"새로 나온 운세"},{"id":"s4518","ko":"토정비결"}]