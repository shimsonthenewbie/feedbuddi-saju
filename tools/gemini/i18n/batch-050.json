[{"id":"s2149","ko":"줍"},{"id":"s2150","ko":"횡재·당첨"},{"id":"s2151","ko":"재물과 기회가 들어오는 길몽이지만, 요행보다 노력의 결과로 이어진다고 봐요."},{"id":"s2152","ko":"보상받고 싶은 마음, 상황이 한 번에 나아지길 바라는 기대예요."},{"id":"s2153","ko":"벗고"},{"id":"s2154","ko":"옷을 안"},{"id":"s2155","ko":"옷이 없"},{"id":"s2156","ko":"속옷"},{"id":"s2157","ko":"벗은 채 노출"},{"id":"s2158","ko":"숨기던 일이 드러날까 하는 걱정, 혹은 마음을 솔직히 열라는 뜻으로 봐요."},{"id":"s2159","ko":"평가받는 상황에서의 불안, 준비 안 된 모습이 들킬까 하는 걱정이에요."},{"id":"s2160","ko":"말이 안 나"},{"id":"s2161","ko":"소리가 안"},{"id":"s2162","ko":"소리를 질러도"},{"id":"s2163","ko":"목소리가 안"},{"id":"s2164","ko":"몸이 안 움직"},{"id":"s2165","ko":"움직일 수 없"},{"id":"s2166","ko":"말·몸이 안 움직임"},{"id":"s2167","ko":"하고 싶은 말을 못 하거나 막힌 일이 있다는 뜻으로 봐요."},{"id":"s2168","ko":"표현하지 못한 감정, 무력감, 또는 몸이 지쳐 있다는 신호예요."},{"id":"s2169","ko":"수영"},{"id":"s2170","ko":"잠수"},{"id":"s2171","ko":"익사"},{"id":"s2172","ko":"_물에 빠"},{"id":"s2173","ko":"물속에 빠"},{"id":"s2174","ko":"물에 빠짐"},{"id":"s2175","ko":"물이 맑으면 재물이, 탁하면 걱정이 있다고 봐요. 무사히 나오면 문제가 해결된다고 해요."},{"id":"s2176","ko":"감정에 휩싸이거나 일에 잠겨 숨이 찬 상태일 수 있어요."},{"id":"s2177","ko":"춤"},{"id":"s2178","ko":"노래"},{"id":"s2179","ko":"공연"},{"id":"s2180","ko":"무대"},{"id":"s2181","ko":"무대·노래"},{"id":"s2182","ko":"기쁜 일과 인정받을 일이 있다는 뜻으로 봐요."},{"id":"s2183","ko":"나를 표현하고 인정받고 싶은 욕구예요."},{"id":"s2184","ko":"공부"},{"id":"s2185","ko":"숙제"},{"id":"s2186","ko":"과제"},{"id":"s2187","ko":"발표"},{"id":"s2188","ko":"답안"}]