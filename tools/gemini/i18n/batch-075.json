[{"id":"s3479","ko":"해가 떠오르듯 나아가기"},{"id":"s3480","ko":"인정받고 올라서는 기운이에요. 눈에 띄는 자리에서 성실함을 보여 주세요."},{"id":"s3481","ko":"내 성과를 보이게 정리해요."},{"id":"s3482","ko":"명이"},{"id":"s3483","ko":"빛을 감추는 때"},{"id":"s3484","ko":"밝은 재능을 드러내면 질투를 살 수 있어요. 속으로 힘을 기르며 때를 기다려요."},{"id":"s3485","ko":"오늘은 조용히 내 일에 집중해요."},{"id":"s3486","ko":"가인"},{"id":"s3487","ko":"집안과 가까운 사이"},{"id":"s3488","ko":"가까운 사람 사이를 돌보면 모든 일이 안정돼요. 집과 가족이 힘의 바탕이에요."},{"id":"s3489","ko":"가족에게 먼저 따뜻한 말을 해요."},{"id":"s3490","ko":"규"},{"id":"s3491","ko":"서로 어긋나는 때"},{"id":"s3492","ko":"뜻이 안 맞고 엇갈려도 작은 일은 함께 풀 수 있어요. 큰 일은 서두르지 말아요."},{"id":"s3493","ko":"다름을 인정하는 한마디를 해요."},{"id":"s3495","ko":"절룩거리며 가는 길"},{"id":"s3496","ko":"앞이 물이고 뒤가 산이라 막히는 느낌이에요. 돌아가고 도움을 받으면 풀려요."},{"id":"s3497","ko":"어려운 점을 솔직히 털어놓아요."},{"id":"s3499","ko":"풀려나는 날"},{"id":"s3500","ko":"엉켰던 일이 풀려요. 해결됐으면 뒤끝 없이 가볍게 넘기세요."},{"id":"s3501","ko":"오래 끌던 일을 마무리해요."},{"id":"s3502","ko":"손"},{"id":"s3503","ko":"덜어 내야 얻는 날"},{"id":"s3504","ko":"덜어 내는 것이 오히려 이득이 돼요. 정성을 담아 줄이면 마음이 가벼워져요."},{"id":"s3505","ko":"불필요한 구독이나 약속을 줄여요."},{"id":"s3506","ko":"익"},{"id":"s3507","ko":"더해지고 이로운 날"},{"id":"s3508","ko":"도움과 기회가 늘어나는 때예요. 이럴 때 크게 시도해 보면 좋아요."},{"id":"s3509","ko":"미뤄 둔 도전을 시작해요."},{"id":"s3510","ko":"쾌"},{"id":"s3511","ko":"결단하고 터뜨리기"},{"id":"s3512","ko":"분명히 정리해야 할 일이 있어요. 단호하되 말은 부드럽게 하세요."},{"id":"s3513","ko":"끌던 결정을 오늘 내려요."},{"id":"s3514","ko":"구"},{"id":"s3515","ko":"뜻밖의 만남"},{"id":"s3516","ko":"갑작스러운 인연이 와요. 끌려도 천천히 알아본 뒤 가까이하세요."},{"id":"s3517","ko":"새 인연은 한 번 더 지켜봐요."},{"id":"s3518","ko":"췌"},{"id":"s3519","ko":"모이고 모이는 날"},{"id":"s3520","ko":"사람과 자원이 모여요. 모임에는 중심과 질서가 있어야 해요."}]