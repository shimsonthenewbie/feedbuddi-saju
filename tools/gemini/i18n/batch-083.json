[{"id":"s3831","ko":"띠가 서로 잘 맞물려요."},{"id":"s3832","ko":"띠가 서로 부딪혀 의견이 갈리기 쉬워요."},{"id":"s3833","ko":"내가 부담스러워하는 ${EL_KO[e ?? '']} 기운이 강해요."},{"id":"s3834","ko":"내 일간과 하늘 글자가 합을 이뤄 끌리는 힘이 있어요."},{"id":"s3835","ko":"특별히 크게 도움도 부딪힘도 없는 무난한 해예요."},{"id":"s3836","ko":"필요한"},{"id":"s3837","ko":"나와 같은 힘의 날"},{"id":"s3838","ko":"내 몫을 나누게 되는 경쟁의 날"},{"id":"s3839","ko":"여유롭게 표현하고 즐기는 날"},{"id":"s3840","ko":"말이 앞서고 튀기 쉬운 날"},{"id":"s3841","ko":"큰 돈과 기회가 움직이는 날"},{"id":"s3842","ko":"안정적인 돈과 실속이 따르는 날"},{"id":"s3843","ko":"압박과 긴장이 오는 날"},{"id":"s3844","ko":"신용과 질서가 서는 날"},{"id":"s3845","ko":"생각이 많고 변덕이 생기는 날"},{"id":"s3846","ko":"문서와 도움, 안정이 따르는 날"},{"id":"s3847","ko":"모든 일에 좋지 않다고 보는 날"},{"id":"s3848","ko":"황도일"},{"id":"s3849","ko":"흑도일"},{"id":"s3850","ko":"손 없는 날"},{"id":"s3851","ko":"내 일지"},{"id":"s3853","ko":"원진"},{"id":"s3854","ko":"바보"},{"id":"s3855","ko":"새 출발·순수"},{"id":"s3856","ko":"계산 없이 가볍게 첫걸음을 떼기 좋은 때예요. 두려움보다 호기심을 따라가 보세요."},{"id":"s3857","ko":"준비 없이 뛰어들거나 망설이느라 멈춰 있을 수 있어요. 발밑만 한 번 살피고 가세요."},{"id":"s3858","ko":"마법사"},{"id":"s3859","ko":"의지·실행력"},{"id":"s3860","ko":"가진 재료가 이미 충분해요. 원하는 것을 구체적으로 정하고 시작하면 이루어져요."},{"id":"s3861","ko":"말만 앞서거나 재능을 흩뜨리고 있어요. 하나에 집중하세요."},{"id":"s3862","ko":"여사제"},{"id":"s3863","ko":"직감·고요"},{"id":"s3864","ko":"답은 밖이 아니라 안에 있어요. 서두르지 말고 조용히 직감을 들어 보세요."},{"id":"s3865","ko":"속마음을 숨기거나 너무 눌러 두고 있어요. 감정을 인정하는 것부터 시작하세요."},{"id":"s3866","ko":"여황제"},{"id":"s3867","ko":"풍요·돌봄"},{"id":"s3868","ko":"가꾸고 키운 것이 열매를 맺는 풍요로운 흐름이에요. 즐기고 누리는 것도 일이에요."},{"id":"s3869","ko":"과하게 챙기거나 자신을 돌보지 않고 있어요. 나를 먼저 채우세요."},{"id":"s3870","ko":"황제"},{"id":"s3871","ko":"질서·책임"}]