[{"id":"s2880","ko":"통보"},{"id":"s2881","ko":"울"},{"id":"s2882","ko":"이별이나 버림받는 꿈은 관계 자체가 끝난다는 뜻이라기보다 \"관계에서 확인받고 싶은 마음\"이나 불안이 올라온 것일 때가 많아요. 이미 정리된 마음을 확인하는 과정일 수도 있어요."},{"id":"s2883","ko":"지금 관계에서 내가 가장 확인받고 싶은 것은 무엇인가요?"},{"id":"s2884","ko":"불안한 마음을 상대나 믿을 만한 사람에게 부드럽게 말로 꺼내 보세요."},{"id":"s2885","ko":"설레는 만남·고백의 꿈"},{"id":"s2890","ko":"설레"},{"id":"s2894","ko":"설레는 만남이나 고백이 나오는 꿈은 사랑받고 싶고 가까워지고 싶은 마음이 올라온 상태예요. 현실의 상대와 이어질 수도 있지만 대부분은 지금 내가 필요로 하는 감정(인정, 따뜻함, 설렘)을 마음이 그려 본 것이에요."},{"id":"s2895","ko":"요즘 내가 가장 받고 싶은 마음의 선물은 무엇인가요?"},{"id":"s2896","ko":"스스로를 위해 작은 설렘(좋아하는 음악, 산책, 새 옷)을 하나 챙겨 보세요."},{"id":"s2897","ko":"무서움"},{"id":"s2898","ko":"무서"},{"id":"s2899","ko":"겁"},{"id":"s2900","ko":"두려"},{"id":"s2901","ko":"소름"},{"id":"s2902","ko":"공포"},{"id":"s2903","ko":"불안"},{"id":"s2905","ko":"초조"},{"id":"s2906","ko":"걱정"},{"id":"s2907","ko":"조마조마"},{"id":"s2908","ko":"기쁨"},{"id":"s2909","ko":"기뻤"},{"id":"s2910","ko":"기쁘"},{"id":"s2911","ko":"행복"},{"id":"s2912","ko":"좋았"},{"id":"s2913","ko":"신났"},{"id":"s2914","ko":"설렘"},{"id":"s2915","ko":"설렜"},{"id":"s2917","ko":"슬픔"},{"id":"s2918","ko":"슬펐"},{"id":"s2919","ko":"슬프"},{"id":"s2923","ko":"서러"},{"id":"s2924","ko":"분노"},{"id":"s2925","ko":"화가"},{"id":"s2927","ko":"짜증"},{"id":"s2928","ko":"열받"},{"id":"s2929","ko":"억울"},{"id":"s2930","ko":"당황"},{"id":"s2932","ko":"놀랐"},{"id":"s2933","ko":"놀라"}]