[{"id":"s490","ko":"활동적인 돈과 기회"},{"id":"s491","ko":"꾸준한 수입"},{"id":"s492","ko":"책임과 평가"},{"id":"s493","ko":"질서와 직위"},{"id":"s494","ko":"새로운 배움"},{"id":"s495","ko":"도움과 안정"},{"id":"s496","ko":"{when}, 인연의 문이 열려요"},{"id":"s497","ko":"{when}, 마음이 오가기 좋은 때예요"},{"id":"s498","ko":"{when}, 일에서 인정받기 좋아요"},{"id":"s499","ko":"{when}, 역할이 커질 때예요"},{"id":"s500","ko":"{when}, 수입의 길이 보여요"},{"id":"s501","ko":"{when}, 재물 흐름이 좋은 때예요"},{"id":"s502","ko":"{when}, 몸의 리듬이 안정돼요"},{"id":"s503","ko":"{when}, 컨디션을 끌어올리기 좋아요"},{"id":"s504","ko":"{when}, 관계가 부드럽게 풀려요"},{"id":"s505","ko":"{when}, 대화가 잘 통하는 때예요"},{"id":"s506","ko":"{when}, 흐름이 좋은 때예요"},{"id":"s507","ko":"{when}, 시도하기 좋은 때예요"},{"id":"s508","ko":"이 사주의 앞으로 12개월 중에서 가장 흐름이 좋은 구간이에요. 이 시기를 기준으로 준비하면 좋아요."},{"id":"s509","ko":"내 사주 기준으로 기운이 잘 받쳐 주는 달이에요. 미리 준비한 만큼 결과가 따라오기 쉬워요."},{"id":"s510","ko":"앞으로 12개월 안에 뚜렷하게 치솟는 시기는 없고, 비교적 고른 흐름이에요. 꾸준히 쌓는 쪽이 유리해요."},{"id":"s511","ko":"{ganziKo}월에는"},{"id":"s512","ko":"{stemMean}({stemSip})의 기운과"},{"id":"s513","ko":"{branchMean}({branchSip})의 기운이 함께 들어와요."},{"id":"s514","ko":"{stemMean}({stemSip})의 기운이 겹쳐서 크게 들어와요."},{"id":"s515","ko":" 다만 내 사주와 {kinds} 부분이 있어 일정이 흔들릴 수 있으니 여유를 두세요."},{"id":"s516","ko":" 내 사주와 서로 끌려서 사람과 일이 잘 맞물려요."},{"id":"s517","ko":"{year}년은 {yg}년이에요."},{"id":"s518","ko":"타고난 힘이 강한 사주예요. 스스로 밀고 나가는 힘이 좋고, 그 힘을 쓸 곳(일·표현·관계)을 정해 주면 성과가 나요."},{"id":"s519","ko":"주변의 도움을 받을 때 힘이 나는 사주예요. 혼자 버티기보다 믿을 사람과 나누면 흐름이 좋아져요."},{"id":"s520","ko":"힘이 한쪽으로 치우치지 않은 균형형이에요. 상황에 맞춰 유연하게 움직이는 쪽이 잘 맞아요."},{"id":"s521","ko":"나에게 도움이 되는 기운은 {el}이에요. {el} 쪽 활동이나 환경을 가까이 하면 좋아요."},{"id":"s522","ko":"나무(목)"},{"id":"s523","ko":"불(화)"},{"id":"s524","ko":"흙(토)"},{"id":"s525","ko":"쇠(금)"},{"id":"s526","ko":"물(수)"},{"id":"s527","ko":"언제가 좋은가"},{"id":"s528","ko":"좋은 달"},{"id":"s529","ko":"신중할 달"}]