[{"id":"s3393","ko":"함께할 사람에게 제안해요."},{"id":"s3394","ko":"대유"},{"id":"s3395","ko":"크게 가진 날"},{"id":"s3396","ko":"가진 것이 많을 때예요. 자랑보다 나누면 복이 더 커져요."},{"id":"s3397","ko":"고마운 사람에게 작은 선물을 해요."},{"id":"s3398","ko":"겸"},{"id":"s3399","ko":"낮추면 높아지는 날"},{"id":"s3400","ko":"스스로 낮추는 사람이 결국 존중받아요. 오늘은 공을 남에게 돌려 보세요."},{"id":"s3401","ko":"칭찬 한마디를 먼저 건네요."},{"id":"s3402","ko":"예"},{"id":"s3403","ko":"기쁘게 준비하기"},{"id":"s3404","ko":"분위기가 들뜨고 즐거워요. 즐기되 미리 대비해 두면 기쁨이 길어요."},{"id":"s3405","ko":"즐거운 일정 하나를 잡아요."},{"id":"s3407","ko":"흐름을 따르기"},{"id":"s3408","ko":"고집을 내려놓고 흐름에 맞출 때 풀려요. 따르더라도 옳은 쪽을 고르세요."},{"id":"s3409","ko":"내 방식 하나를 유연하게 바꿔요."},{"id":"s3410","ko":"고"},{"id":"s3411","ko":"묵은 문제 손보기"},{"id":"s3412","ko":"오래 방치한 일이 드러나요. 지금 고치면 새 출발이 돼요."},{"id":"s3413","ko":"미뤄 둔 정리 하나를 끝내요."},{"id":"s3414","ko":"임"},{"id":"s3415","ko":"가까이 다가오는 기회"},{"id":"s3416","ko":"좋은 기운이 다가오는 중이에요. 성의 있게 맞이하되, 좋은 때가 오래가지는 않으니 준비하세요."},{"id":"s3417","ko":"지금 할 수 있는 최선을 해요."},{"id":"s3418","ko":"관"},{"id":"s3419","ko":"멀리서 살펴보기"},{"id":"s3420","ko":"나서기보다 관찰할 때예요. 보고 나서 움직이면 틀림이 적어요."},{"id":"s3421","ko":"결정 전에 자료를 하나 더 봐요."},{"id":"s3422","ko":"서합"},{"id":"s3423","ko":"걸림돌을 씹어 넘기기"},{"id":"s3424","ko":"중간에 걸리는 문제를 분명히 해결해야 해요. 흐지부지하면 다시 와요."},{"id":"s3425","ko":"불편한 이야기를 정중히 꺼내요."},{"id":"s3427","ko":"꾸미고 다듬기"},{"id":"s3428","ko":"겉모습과 포장이 힘이 되는 날이에요. 다만 속이 비면 금방 티가 나요."},{"id":"s3429","ko":"옷차림이나 문서를 정돈해요."},{"id":"s3430","ko":"박"},{"id":"s3431","ko":"벗겨져 나가는 때"},{"id":"s3432","ko":"가진 것이 깎이는 느낌이 들 수 있어요. 지킬 것만 남기고 움츠리면 지나가요."},{"id":"s3433","ko":"큰 지출과 승부수는 피해요."},{"id":"s3434","ko":"복"}]