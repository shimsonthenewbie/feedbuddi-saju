[{"id":"s2067","ko":"공항"},{"id":"s2068","ko":"배를 타"},{"id":"s2069","ko":"유람선"},{"id":"s2070","ko":"여행"},{"id":"s2071","ko":"출장"},{"id":"s2072","ko":"여행·비행기"},{"id":"s2073","ko":"멀리 떠나거나 새 환경으로 옮기는 일, 큰 이동수를 뜻한다고 봐요."},{"id":"s2074","ko":"환경을 바꾸고 싶은 마음, 낯선 곳에 대한 기대와 불안이에요."},{"id":"s2075","ko":"교통사고"},{"id":"s2076","ko":"사고가"},{"id":"s2077","ko":"충돌"},{"id":"s2078","ko":"브레이크"},{"id":"s2079","ko":"차가 멈"},{"id":"s2080","ko":"운전이"},{"id":"s2081","ko":"사고·브레이크"},{"id":"s2082","ko":"조심하라는 경고로 보되, 실제 사고를 예언하는 것은 아니라고 봐요."},{"id":"s2083","ko":"속도가 너무 빠르다고 느끼거나 통제가 어렵다는 불안이에요."},{"id":"s2084","ko":"감옥"},{"id":"s2085","ko":"갇혀"},{"id":"s2086","ko":"갇힌"},{"id":"s2087","ko":"창살"},{"id":"s2088","ko":"엘베에 갇"},{"id":"s2089","ko":"탈출"},{"id":"s2090","ko":"갇힘·탈출"},{"id":"s2091","ko":"답답한 상황이 풀려 나오면 길하고, 못 나오면 부담이 지속된다고 봐요."},{"id":"s2092","ko":"벗어나고 싶은 상황이나 역할이 있다는 뜻이에요."},{"id":"s2093","ko":"내가 죽"},{"id":"s2094","ko":"죽는 꿈"},{"id":"s2095","ko":"죽었"},{"id":"s2096","ko":"죽을 뻔"},{"id":"s2097","ko":"사망"},{"id":"s2098","ko":"내가 죽는 꿈"},{"id":"s2099","ko":"내가 죽는 꿈은 오히려 새 출발과 장수를 뜻한다고 보는 해석이 많아요."},{"id":"s2100","ko":"낡은 자아와 오래된 방식을 끝내고 새로 시작하고 싶은 마음이에요."},{"id":"s2101","ko":"싸우"},{"id":"s2102","ko":"싸움"},{"id":"s2103","ko":"다퉜"},{"id":"s2104","ko":"때리"},{"id":"s2105","ko":"맞았"},{"id":"s2106","ko":"폭행"},{"id":"s2107","ko":"욕을"},{"id":"s2109","ko":"말다툼은 구설, 이기면 일이 풀리고 지면 조심하라는 뜻으로 봐요."},{"id":"s2110","ko":"표현하지 못한 분노나 경계를 지키고 싶은 마음이 있을 수 있어요."},{"id":"s2111","ko":"울었"},{"id":"s2112","ko":"울고"},{"id":"s2113","ko":"눈물"},{"id":"s2114","ko":"통곡"},{"id":"s2115","ko":"우는 꿈"},{"id":"s2116","ko":"꿈에서 울면 현실의 근심이 풀린다고 보는 반대 해석이 있어요."},{"id":"s2117","ko":"참아 온 감정이 풀려나는 과정일 수 있어요."},{"id":"s2118","ko":"웃었"},{"id":"s2119","ko":"웃고"},{"id":"s2120","ko":"웃음"},{"id":"s2121","ko":"웃는 꿈"},{"id":"s2122","ko":"기쁜 웃음은 좋은 소식을, 억지 웃음이나 비웃음은 구설을 조심하라고 봐요."},{"id":"s2123","ko":"웃음의 이유가 편안함인지 어색함인지가 지금 마음 상태를 알려 줘요."},{"id":"s2124","ko":"이혼"},{"id":"s2125","ko":"이별"},{"id":"s2126","ko":"결별"},{"id":"s2127","ko":"헤어지