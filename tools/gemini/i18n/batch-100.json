[{"id":"s4576","ko":"궁합 보기"},{"id":"s4580","ko":"년"},{"id":"s4581","ko":"나를 나타내는 글자 (일간)"},{"id":"s4587","ko":"다섯 기운 분포 (오행)"},{"id":"s4588","ko":"10년 단위 큰 흐름 (대운)"},{"id":"s4589","ko":"세"},{"id":"s4590","ko":"AI에게 풀이 받기"},{"id":"s4591","ko":"아래 요청문을 복사해서 AI에 붙여넣으면, 이 차트를 바탕으로 풀이해줘요."},{"id":"s4592","ko":"요청문 복사하기"},{"id":"s4593","ko":"복사했어요! AI에 붙여넣으세요"},{"id":"s4594","ko":"복사하고 열기"},{"id":"s4595","ko":"요청문 미리보기"},{"id":"s4596","ko":"계산은 이 브라우저 안에서만 해요. 입력한 생년월일은 이 기기에만 저장돼요. 단, AI에 붙여넣으면 그 서비스로 전송되니 참고하세요."},{"id":"s4597","ko":"재미와 참고용이에요. 중요한 결정은 스스로 판단해 주세요. 모든 풀이는 명리학 이론, 그중 자평명리 기준으로 계산한 결과예요."},{"id":"s4598","ko":"생년월일을 입력해 주세요."},{"id":"s4599","ko":"태어난 시각을 입력하거나 \"시간을 몰라요\"를 체크해 주세요."},{"id":"s4600","ko":"출생지를 찾지 못했어요. 도시 이름을 다시 검색해 주세요."},{"id":"s4601","ko":"계산에 실패했어요. 날짜와 출생지를 확인해 주세요."},{"id":"s4602","ko":"풀이 언어"},{"id":"s4603","ko":"사주 계산은 용용사주 자체 엔진으로 해요(절기 계산: lunar-javascript, MIT). 조후 풀이는 옛 고전 궁통보감의 표(위키문헌, CC BY-SA 4.0)를 바탕으로 해요."},{"id":"s4604","ko":"소스 코드 보기"},{"id":"s4605","ko":"의 사주"},{"id":"s4609","ko":"정보 바꾸기"},{"id":"s4610","ko":"준비 중인 풀이"},{"id":"s4611","ko":"가격과 구성은 아직 정해지지 않았어요. 지금은 둘러보기만 가능해요."},{"id":"s4613","ko":"매일 확인하는 하루 흐름"},{"id":"s4615","ko":"올해 흐름"},{"id":"s4616","ko":"월별로 보는 올해의 기회와 쉬어갈 때"},{"id":"s4618","ko":"연애·궁합"},{"id":"s4619","ko":"나의 인연 스타일과 시기"},{"id":"s4621","ko":"재물·직업"},{"id":"s4622","ko":"어울리는 일의 형태와 돈의 흐름"},{"id":"s4624","ko":"건강·컨디션"},{"id":"s4625","ko":"타고난 체질 경향과 생활 팁"},{"id":"s4628","ko":"12단계로 풀어 쓰는 평생 사주"},{"id":"s4634","ko":"AI 풀이를 쓰려면 위의 동의 칸을 체크해 주세요."},{"id":"s4635","ko":"${y0 + 1}년 조심할 것"},{"id":"s4636","ko":"${y0 + 1}년에 들어오는 살"},{"id":"s4637","ko":"${y0 + yearSel}년"},{"id":"s4638","ko":"괘 번호"}]