[{"id":"s3348","ko":"앞에 나서기보다 받아 주고 뒷받침할 때 빛나는 날이에요. 부드러움이 가장 강한 힘이에요."},{"id":"s3349","ko":"오늘은 남의 이야기를 끝까지 들어요."},{"id":"s3350","ko":"둔"},{"id":"s3351","ko":"막 싹이 트는 어려움"},{"id":"s3352","ko":"시작은 늘 어수선해요. 막히는 느낌은 정상이니, 혼자 다 하려 말고 도움을 구하세요."},{"id":"s3353","ko":"작은 것 하나만 먼저 끝내요."},{"id":"s3354","ko":"몽"},{"id":"s3355","ko":"아직 모르는 단계"},{"id":"s3356","ko":"모르는 것을 인정하면 배움이 열려요. 아는 척보다 묻는 쪽이 빨라요."},{"id":"s3357","ko":"궁금한 것 하나를 찾아봐요."},{"id":"s3359","ko":"기다림의 때"},{"id":"s3360","ko":"준비는 됐는데 때가 아직이에요. 서두르면 놓치고 기다리면 와요. 그동안 몸과 마음을 채워 두세요."},{"id":"s3361","ko":"오늘은 든든히 먹고 푹 쉬어요."},{"id":"s3362","ko":"송"},{"id":"s3363","ko":"따지기 쉬운 날"},{"id":"s3364","ko":"말다툼이나 시비에 휘말리기 쉬워요. 이겨도 남는 게 적으니 한 발 물러서는 쪽이 이득이에요."},{"id":"s3365","ko":"답장은 한 시간 뒤에 해요."},{"id":"s3367","ko":"질서 있게 움직이기"},{"id":"s3368","ko":"혼자보다 팀으로, 감정보다 규칙으로 움직일 때 성과가 나요. 리더라면 책임도 함께 져요."},{"id":"s3369","ko":"할 일의 순서를 적고 시작해요."},{"id":"s3371","ko":"가까이 모이기"},{"id":"s3372","ko":"마음 맞는 사람과 가까워지기 좋은 날이에요. 먼저 손을 내밀면 관계가 따뜻해져요."},{"id":"s3373","ko":"안부 연락을 한 명에게 보내요."},{"id":"s3374","ko":"소축"},{"id":"s3375","ko":"조금씩 쌓기"},{"id":"s3376","ko":"큰 변화보다 작은 축적이 맞는 날이에요. 답답해도 구름이 모이는 중이에요."},{"id":"s3377","ko":"하루 10분이라도 꾸준히 해요."},{"id":"s3378","ko":"리"},{"id":"s3379","ko":"조심스럽게 걷기"},{"id":"s3380","ko":"호랑이 꼬리를 밟듯 예의와 조심이 필요한 자리예요. 예절을 지키면 위험도 지나가요."},{"id":"s3381","ko":"약속 시간과 인사를 챙겨요."},{"id":"s3383","ko":"술술 통하는 날"},{"id":"s3384","ko":"위아래가 잘 통해 일이 풀려요. 좋을 때일수록 겸손하면 오래 가요."},{"id":"s3385","ko":"미뤄 둔 부탁을 오늘 꺼내요."},{"id":"s3387","ko":"막혀서 안 통하는 날"},{"id":"s3388","ko":"말이 엇나가고 일이 막힐 수 있어요. 억지로 뚫기보다 내실을 다지며 버티세요."},{"id":"s3389","ko":"무리한 결정은 내일로 미뤄요."},{"id":"s3390","ko":"동인"},{"id":"s3391","ko":"뜻을 함께하기"},{"id":"s3392","ko":"같은 목표를 가진 사람과 힘을 합치면 크게 풀려요. 편 가르기만 조심해요."},{"id":"s3393","ko":"함께할 사람에게 제안해요."},{"id":"s3394","ko":"대유"},{"id":"s3395","ko":"크게 가진 날"},{"id":"s3396","ko":"가진 것이 많을 때예요. 자랑보다 나누면 복이 더 커져요."},{"id":"s3397","ko":"고마운 사람에게 작은 선물을 해요."},{"id":"s3398","ko":"겸"},{"id":"s3399","ko":"낮추면 높아지는 날"},{"id":"s3400","ko":"스스로 낮추는 사람이 결국 존중받아요. 오늘은 공을 남에게 돌려 보세요."},{"id":"s3401","ko":"칭찬 한마디를 먼저 건네요."},{"id":"s3402","ko":"예"},{"id":"s3403","ko":"기쁘게 준비하기"},{"id":"s3404","ko":"분위기가 들뜨고 즐거워요. 즐기되 미리 대비해 두면 기쁨이 길어요."},{"id":"s3405","ko":"즐거운 일정 하나를 잡아요."},{"id":"s3407","ko":"흐름을 따르기"},{"id":"s3408","ko":"고집을 내려놓고 흐름에 맞출 때 풀려요. 따르더라도 옳은 쪽을 고르세요."},{"id":"s3409","ko":"내 방식 하나를 유연하게 바꿔요."},{"id":"s3410","ko":"고"},{"id":"s3411","ko":"묵은 문제 손보기"},{"id":"s3412","ko":"오래 방치한 일이 드러나요. 지금 고치면 새 출발이 돼요."},{"id":"s3413","ko":"미뤄 둔 정리 하나를 끝내요."},{"id":"s3414","ko":"임"},{"id":"s3415","ko":"가까이 다가오는 기회"},{"id":"s3416","ko":"좋은 기운이 다가오는 중이에요. 성의 있게 맞이하되, 좋은 때가 오래가지는 않으니 준비하세요."},{"id":"s3417","ko":"지금 할 수 있는 최선을 해요."},{"id":"s3418","ko":"관"},{"id":"s3419","ko":"멀리서 살펴보기"},{"id":"s3420","ko":"나서기보다 관찰할 때예요. 보고 나서 움직이면 틀림이 적어요."},{"id":"s3421","ko":"결정 전에 자료를 하나 더 봐요."},{"id":"s3422","ko":"서합"},{"id":"s3423","ko":"걸림돌을 씹어 넘기기"},{"id":"s3424","ko":"중간에 걸리는 문제를 분명히 해결해야 해요. 흐지부지하면 다시 와요."},{"id":"s3425","ko":"불편한 이야기를 정중히 꺼내요."},{"id":"s3427","ko":"꾸미고 다듬기"},{"id":"s3428","ko":"겉모습과 포장이 힘이 되는 날이에요. 다만 속이 비면 금방 티가 나요."},{"id":"s3429","ko":"옷차림이나 문서를 정돈해요."},{"id":"s3430","ko":"박"},{"id":"s3431","ko":"벗겨져 나가는 때"},{"id":"s3432","ko":"가진 것이 깎이는 느낌이 들 수 있어요. 지킬 것만 남기고 움츠리면 지나가요."},{"id":"s3433","ko":"큰 지출과 승부수는 피해요."},{"id":"s3434","ko":"복"},{"id":"s3435","ko":"다시 돌아오는 힘"},{"id":"s3436","ko":"바닥을 찍고 다시 올라오는 첫 신호가 있어요. 작은 회복을 소중히 키워요."},{"id":"s3437","ko":"쉬었던 습관 하나를 다시 시작해요."},{"id":"s3438","ko":"무망"},{"id":"s3439","ko":"꾸밈없이 순수하게"},{"id":"s3440","ko":"계산 없이 솔직한 쪽이 맞아요. 욕심내서 얻으려 하면 오히려 탈이 나요."},{"id":"s3441","ko":"있는 그대로 말해요."},{"id":"s3442","ko":"대축"},{"id":"s3443","ko":"크게 쌓아 두기"},{"id":"s3444","ko":"실력과 힘을 크게 모으는 때예요. 지금 쌓는 공부가 나중에 큰 힘이 돼요."},{"id":"s3445","ko":"배움에 시간을 써요."},{"id":"s3447","ko":"입과 먹는 것 돌보기"},{"id":"s3448","ko":"무엇을 먹고 무슨 말을 하는지가 중요한 날이에요. 몸과 말을 건강하게 기르세요."},{"id":"s3449","ko":"식사를 제때 하고 말을 아껴요."},{"id":"s3450","ko":"대과"},{"id":"s3451","ko":"짐이 너무 무거울 때"},{"id":"s3452","ko":"기둥이 휠 만큼 부담이 커요. 혼자 버티지 말고 짐을 나누거나 덜어요."},{"id":"s3453","ko":"해야 할 일 하나를 내려놓아요."},{"id":"s3455","ko":"거듭된 물길"},{"id":"s3456","ko":"어려움이 겹쳐도 물은 낮은 데로 흘러 길을 만들어요. 정성을 다하면 지나가요."},{"id":"s3457","ko":"걱정은 적고 한 걸음씩 가요."},{"id":"s3459","ko":"밝게 붙어 빛나기"},{"id":"s3460","ko":"밝은 곳에 의지하면 환해져요. 좋은 사람·좋은 목표에 붙어 가세요."},{"id":"s3461","ko":"존경하는 사람의 방식을 따라 해 봐요."},{"id":"s3462","ko":"함"},{"id":"s3463","ko":"마음이 서로 통하는 날"},{"id":"s3464","ko":"마음이 움직이고 끌림이 생겨요. 진심으로 다가가면 통해요."},{"id":"s3465","ko":"마음을 솔직하게 표현해요."},{"id":"s3466","ko":"항"},{"id":"s3467","ko":"꾸준함이 힘"},{"id":"s3468","ko":"한결같이 이어 가는 것이 가장 큰 힘이에요. 변덕은 줄이고 리듬을 지켜요."},{"id":"s3469","ko":"매일 하는 습관을 오늘도 해요."},{"id":"s3471","ko":"물러나는 지혜"},{"id":"s3472","ko":"지금은 맞서기보다 한 발 물러서는 쪽이 이득이에요. 피하는 것도 용기예요."},{"id":"s3473","ko":"굳이 이기려 하지 말아요."},{"id":"s3474","ko":"대장"},{"id":"s3475","ko":"힘이 센 날"},{"id":"s3476","ko":"기세가 좋지만 힘만 믿으면 부딪혀요. 옳은 방향에만 쓰세요."},{"id":"s3477","ko":"힘 쓸 일은 정중하게 해요."},{"id":"s3478","ko":"진"}]