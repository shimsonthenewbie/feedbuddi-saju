[{"id":"s1944","ko":"학교"},{"id":"s1945","ko":"교실"},{"id":"s1946","ko":"학생"},{"id":"s1947","ko":"졸업"},{"id":"s1948","ko":"학교·선생님"},{"id":"s1949","ko":"평가와 배움, 오래 남은 숙제를 뜻하는 꿈이에요."},{"id":"s1950","ko":"아직 끝내지 못했다고 느끼는 일, 다시 증명해야 한다는 부담이 있을 수 있어요."},{"id":"s1951","ko":"아이가"},{"id":"s1952","ko":"아이를"},{"id":"s1953","ko":"딸이"},{"id":"s1954","ko":"아들이"},{"id":"s1955","ko":"자녀"},{"id":"s1956","ko":"어린아이"},{"id":"s1957","ko":"아이"},{"id":"s1958","ko":"아이가 건강하고 밝으면 새 일과 기쁜 소식이, 아프거나 울면 돌봄이 필요한 일이 있다고 봐요."},{"id":"s1959","ko":"내 안의 순수한 모습, 돌봐야 하는 책임이나 새 시작을 뜻해요."},{"id":"s1960","ko":"엘리베이터"},{"id":"s1961","ko":"승강기"},{"id":"s1962","ko":"에스컬레이터"},{"id":"s1964","ko":"올라가면 승진과 상승운, 내려가거나 멈추면 잠시 쉬어 가라는 뜻으로 봐요."},{"id":"s1965","ko":"내 위치가 오르내린다는 감각, 통제가 안 되는 상황에 대한 긴장이에요."},{"id":"s1966","ko":"계단"},{"id":"s1967","ko":"사다리"},{"id":"s1969","ko":"오르면 단계적인 성취, 내려가면 정리와 후퇴를 뜻한다고 봐요."},{"id":"s1970","ko":"한 단계씩 올라가야 한다는 부담이나 성장의 감각을 보여 줘요."},{"id":"s1971","ko":"다리를 건"},{"id":"s1972","ko":"다리가"},{"id":"s1973","ko":"다리 위"},{"id":"s1974","ko":"철교"},{"id":"s1975","ko":"다리(橋)"},{"id":"s1976","ko":"다리를 건너면 어려움을 넘어 새 국면으로 간다고 봐요."},{"id":"s1977","ko":"두 상태 사이에서 건너는 중이라는 느낌, 갈림길의 마음이에요."},{"id":"s1978","ko":"길을 잃"},{"id":"s1979","ko":"길이 막"},{"id":"s1980","ko":"갈림길"},{"id":"s1981","ko":"미로"},{"id":"s1982","ko":"헤매"},{"id":"s1983","ko":"길을 잃음"},{"id":"s1984","ko":"방향을 정하기 전의 망설임, 선택을 앞둔 시기를 뜻한다고 봐요."},{"id":"s1985","ko":"무엇을 원하는지 아직 선명하지 않다는 신호예요. 선택지를 적어 보세요."},{"id":"s1986","ko":"문이 열"},{"id":"s1987","ko":"문을 열"},{"id":"s1988","ko":"잠긴 문"},{"id":"s1989","ko":"문이 잠"},{"id":"s1990","ko":"열쇠"},{"id":"s1991","ko":"문을 못"},{"id":"s1992","ko":"문·열쇠"},{"id":"s1993","ko":"열리면 기회와 해결, 잠겨 있으면 아직 때가 아니거나 막힌 일이 있다고 봐요."},{"id":"s1994","ko":"들어가고 싶은 곳과 막혀 있다고 느끼는 곳이 있다는 뜻이에요."},{"id":"s1995","ko":"거울"},{"id":"s1997","ko":"거울이 깨끗하면 마음이 맑아지고, 깨지면 관계나 일을 점검하라고 봐요."},{"id":"s1998","ko":"내가 나를 어떻게 보고 있는지, 자기 이미지에 대한 생각을 비춰 줘요."},{"id":"s1999","ko":"시계"},{"id":"s2000","ko":"시간이 없"},{"id":"s2001","ko":"늦었"},{"id":"