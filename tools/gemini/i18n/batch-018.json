[{"id":"s2317","ko":"면접"},{"id":"s2318","ko":"수능"},{"id":"s2319","ko":"시험·면접"},{"id":"s2320","ko":"평가받는 일에 대한 긴장을 뜻한다고 봐요."},{"id":"s2321","ko":"압박과 준비 부족에 대한 불안이 드러난 경우가 많아요."},{"id":"s2322","ko":"벗은"},{"id":"s2323","ko":"알몸"},{"id":"s2324","ko":"나체"},{"id":"s2325","ko":"벗은 몸"},{"id":"s2326","ko":"숨기고 싶은 것이 드러날까 하는 걱정으로 봐요."},{"id":"s2327","ko":"노출·평가에 대한 불안, 솔직해지고 싶은 마음일 수 있어요."},{"id":"s2328","ko":"우리 집"},{"id":"s2329","ko":"_집에"},{"id":"s2330","ko":"_집이"},{"id":"s2331","ko":"이사"},{"id":"s2333","ko":"내 방"},{"id":"s2334","ko":"집·방"},{"id":"s2335","ko":"삶의 터전과 마음 상태를 상징해요."},{"id":"s2336","ko":"집의 상태(넓은지, 낡았는지)는 지금 내 마음의 안정감을 보여 줘요."},{"id":"s2337","ko":"자동차"},{"id":"s2338","ko":"운전"},{"id":"s2339","ko":"버스"},{"id":"s2340","ko":"기차"},{"id":"s2341","ko":"택시"},{"id":"s2342","ko":"_차를"},{"id":"s2343","ko":"_차가"},{"id":"s2344","ko":"탈것"},{"id":"s2345","ko":"삶의 방향과 진행을 뜻한다고 봐요."},{"id":"s2346","ko":"내가 운전하는지 끌려가는지가 삶의 주도권에 대한 마음을 보여 줘요."},{"id":"s2347","ko":"전남친"},{"id":"s2348","ko":"전여친"},{"id":"s2349","ko":"전 남친"},{"id":"s2350","ko":"전 여친"},{"id":"s2351","ko":"전 여자친구"},{"id":"s2352","ko":"전 남자친구"},{"id":"s2353","ko":"전 애인"},{"id":"s2354","ko":"전애인"},{"id":"s2355","ko":"옛 애인"},{"id":"s2356","ko":"옛애인"},{"id":"s2357","ko":"옛 연인"},{"id":"s2358","ko":"헤어진"},{"id":"s2360","ko":"지난 인연이 마음에 남아 있다는 뜻으로 봐요."},{"id":"s2361","ko":"그 사람 자체보다 그때의 감정이나 지금 부족한 것을 비추는 경우가 많아요."},{"id":"s2362","ko":"돈을"},{"id":"s2363","ko":"돈이"},{"id":"s2364","ko":"지폐"},{"id":"s2365","ko":"현금"},{"id":"s2366","ko":"금반지"},{"id":"s2367","ko":"금붙이"},{"id":"s2368","ko":"금덩이"},{"id":"s2369","ko":"보석"},{"id":"s2371","ko":"돈·금붙이"},{"id":"s2372","ko":"재물이 들어오거나 기회가 온다는 길한 꿈으로 봐요."},{"id":"s2373","ko":"가치를 인정받고 싶은 마음, 경제적 걱정을 나타내기도 해요."},{"id":"s2375","ko":"_사자"},{"id":"s2376","ko":"_곰"},{"id":"s2377","ko":"맹수"},{"id":"s2378","ko":"큰 힘이나 권위(귀인)를 만나는 꿈으로 보기도 해요."},{"id":"s2379","ko":"위협으로 느꼈다면 압박감, 친근했다면 내 안의 힘을 뜻해요."},{"id":"s2380","ko":"_피가"},{"id":"s2381","ko":"_피를"},{"id":"s2382","ko":"출혈"},{"id":"s2383","ko":"상처"},{"id":"s2384","ko":"피·상처"},{"id":"s2385","ko":"재물이나 큰 변화와 연결해서 보기도 해요."},{"id":"s2386","ko":"마음의 상처, 에너지 소진을 알리는 신호일 수 있어요."},{"id":"s2387","ko":"_꽃"},{"id":"s2389","ko":"꽃이 활짝 피면 기쁜 일과 좋은 인연의 신호로 봐요."},{"id":"s2390","ko":"인정받고 싶은 마음과 기대감을 보여 줘요."},{"id":"s2393","ko":"지켜보는 눈, 영리한 사람, 구설을 조심하라는 뜻으로 보기도 해요."},{"id":"s2394","ko":"독립성과 위로, 혹은 예민해진 감각을 뜻해요."},{"id":"s2396","ko":"_개가"},{"id":"s2397","ko":"_개를"},{"id":"s2399","ko":"충직한 사람과 도움, 때로는 시비를 뜻해요."},{"id":"s2400","ko":"신뢰와 보호받고 싶은 마음을 나타내요."},{"id":"s2401","ko":"지진"},{"id":"s2402","ko":"무너"},{"id":"s2403","ko":"붕괴"},{"id":"s2404","ko":"무너지는 것"},{"id":"s2405","ko":"크게 흔들리는 일이 정리되는 신호로 보기도 해요."},{"id":"s2406","ko":"기반이 흔들리는 불안, 낡은 것을 바꾸고 싶은 마음이에요."},{"id":"s2407","ko":"바람"},{"id":"s2408","ko":"외도"},{"id":"s2409","ko":"양다리"},{"id":"s2410","ko":"환승"},{"id":"s2411","ko":"남자친구가 있"},{"id":"s2412","ko":"여자친구가 있"},{"id":"s2413","ko":"애인이 있"},{"id":"s2414","ko":"삼각"},{"id":"s2415","ko":"삼각관계·바람"},{"id":"s2416","ko":"전통적으로 인연이 얽히거나 마음이 갈라지는 상황을 뜻한다고 봐요."},{"id":"s2417","ko":"관계에서 신뢰·애착에 대한 불안, 경계가 흐려진 상태, 끝내지 못한 마음을 비추는 경우가 많아요."},{"id":"s2418","ko":"결혼"},{"id":"s2419","ko":"웨딩"},{"id":"s2421","ko":"새로운 결합·계약, 인연의 시작을 뜻한다고 봐요."},{"id":"s2422","ko":"관계에 대한 기대나 책임에 대한 부담이 함께 나타나요."},{"id":"s2438","ko":"두려움은 지금 내가 지키고 싶은 것이나 놓칠까 걱정하는 것을 가리켜요."},{"id":"s2439","ko":"불안은 아직 정해지지 않은 일에 대한 마음의 준비 운동이에요. 구체적으로 무엇이 걱정인지 적어 보면 줄어요."},{"id":"s2440","ko":"기쁨이 컸다면 원하던 방향으로 마음이 열려 있다는 신호예요."},{"id":"s2441","ko":"설렘은 새로운 가능성에 마음이 반응하고 있다는 뜻이에요."},{"id":"s2442","ko":"슬픔은 아직 충분히 느끼지 못한 마음이 흘러나온 것일 수 있어요."},{"id":"s2443","ko":"분노는 존중받지 못했다는 마음, 지키고 싶은 선이 넘어갔다는 신호예요."},{"id":"s2444","ko":"당황은 상황이 내 뜻대로 되지 않을 때 나오는 반응이에요. 통제감을 잃은 부분이 있는지 보세요."},{"id":"s2445","ko":"평온했다면 지금 마음이 어느 정도 정리되어 있다는 뜻이에요."},{"id":"s2446","ko":"외로움은 이해받고 싶은 마음, 연결에 대한 욕구가 커졌다는 신호예요."},{"id":"s2447","ko":"그리움은 그 사람 자체보다 그때의 감정이나 지금 부족한 무언가를 향할 때가 많아요."},{"id":"s2448","ko":"혼란은 마음속에 서로 다른 바람이 부딪히고 있다는 뜻이에요. 무엇을 원하는지 하나씩 가려 보세요."},{"id":"s2449","ko":"답답함은 하고 싶은 말이나 행동이 막혀 있다는 신호예요."},{"id":"s2450","ko":"누가·무엇을·어떤 감정으로"},{"id":"s2468","ko":"남친이 있"},{"id":"s2469","ko":"여친이 있"},{"id":"s2470","ko":"결혼했"},{"id":"s2471","ko":"유부"},{"id":"s2472","ko":"지금 남자친구"},{"id":"s2473","ko":"지금 여자친구"},{"id":"s2474","ko":"현재 남자친구"},{"id":"s2475","ko":"현재 여자친구"},{"id":"s2476","ko":"지금 남친"},{"id":"s2477","ko":"지금 여친"},{"id":"s2478","ko":"새 남자친구"}]