[{"id":"s448","ko":"마음의 리듬이 잘 맞아서 함께 있으면 편안하게 풀려요."},{"id":"s449","ko":"결이 달라 처음엔 자극이 되지만, 방식 차이로 부딪히기 쉬워요."},{"id":"s450","ko":"감정을 푸는 방식이 달라서 서운함이 엇갈릴 수 있어요. 마음을 말로 먼저 확인해 주세요."},{"id":"s451","ko":"크게 맞거나 부딪히지 않는 평범한 조합이에요. 서로 알아가며 맞춰 가요."},{"id":"s452","ko":"마음의 리듬이 크게 겹치지도 어긋나지도 않아요. 표현을 자주 해 주면 가까워져요."},{"id":"s453","ko":"한쪽의 마음을 다른 쪽이 자연스럽게 알아주는 신호가 있어요. 편안하게 기댈 수 있는 사이예요."},{"id":"s454","ko":"서로에게 설레는 신호가 있어요. 처음 끌림이 강한 편이에요."},{"id":"s455","ko":"서로의 마음을 잘못 읽기 쉬운 신호가 있어요. 말하지 않은 건 모르니 마음을 직접 말해 주세요."},{"id":"s456","ko":"끌리지만 자극과 긴장도 함께 있어요. 속도를 맞추면 오히려 오래가요."},{"id":"s457","ko":"마음을 알아주는 데 특별한 신호는 없어요. 대화로 쌓아 가는 사이예요."},{"id":"s458","ko":"설렘에 큰 신호는 없어요. 함께한 시간으로 정이 쌓이는 쪽이에요."},{"id":"s459","ko":"나"},{"id":"s460","ko":"상대"},{"id":"s461","ko":"${p.tToday.moon} ${p.names[moonToday]}${lang === 'ko' ? '에 있어요.' : '.'} ${p.today[moonToday]}"},{"id":"s462","ko":"갑을병정무기경신임계"},{"id":"s463","ko":"자축인묘진사오미신유술해"},{"id":"s464","ko":"${w.year}년 ${w.month}월"},{"id":"s465","ko":"정면으로 부딪히는"},{"id":"s466","ko":"마찰이 생기는"},{"id":"s467","ko":"엇갈리는"},{"id":"s468","ko":"살짝 어긋나는"},{"id":"s469","ko":"충"},{"id":"s470","ko":"형"},{"id":"s471","ko":"합"},{"id":"s474","ko":"해"},{"id":"s475","ko":"파"},{"id":"s476","ko":"신강"},{"id":"s477","ko":"극신강"},{"id":"s478","ko":"신약"},{"id":"s479","ko":"극신약"},{"id":"s480","ko":"연애·결혼"},{"id":"s481","ko":"직장·커리어"},{"id":"s482","ko":"재테크·금전"},{"id":"s483","ko":"건강"},{"id":"s484","ko":"가족·인간관계"},{"id":"s485","ko":"기타"},{"id":"s486","ko":"나와 닮은 힘·자기 주관"},{"id":"s487","ko":"경쟁과 협력"},{"id":"s488","ko":"표현과 여유"},{"id":"s489","ko":"재능과 변화"}]