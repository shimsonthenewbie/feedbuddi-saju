[{"id":"s2107","ko":"욕을"},{"id":"s2109","ko":"말다툼은 구설, 이기면 일이 풀리고 지면 조심하라는 뜻으로 봐요."},{"id":"s2110","ko":"표현하지 못한 분노나 경계를 지키고 싶은 마음이 있을 수 있어요."},{"id":"s2111","ko":"울었"},{"id":"s2112","ko":"울고"},{"id":"s2113","ko":"눈물"},{"id":"s2114","ko":"통곡"},{"id":"s2115","ko":"우는 꿈"},{"id":"s2116","ko":"꿈에서 울면 현실의 근심이 풀린다고 보는 반대 해석이 있어요."},{"id":"s2117","ko":"참아 온 감정이 풀려나는 과정일 수 있어요."},{"id":"s2118","ko":"웃었"},{"id":"s2119","ko":"웃고"},{"id":"s2120","ko":"웃음"},{"id":"s2121","ko":"웃는 꿈"},{"id":"s2122","ko":"기쁜 웃음은 좋은 소식을, 억지 웃음이나 비웃음은 구설을 조심하라고 봐요."},{"id":"s2123","ko":"웃음의 이유가 편안함인지 어색함인지가 지금 마음 상태를 알려 줘요."},{"id":"s2124","ko":"이혼"},{"id":"s2125","ko":"이별"},{"id":"s2126","ko":"결별"},{"id":"s2127","ko":"헤어지자"},{"id":"s2128","ko":"헤어졌다고"},{"id":"s2129","ko":"차였"},{"id":"s2131","ko":"관계가 정리되거나 새롭게 바뀌는 시기를 뜻한다고 봐요."},{"id":"s2132","ko":"관계에서 느끼는 불안이거나, 이미 정리된 마음을 확인하는 과정일 수 있어요."},{"id":"s2133","ko":"퇴사"},{"id":"s2134","ko":"해고"},{"id":"s2135","ko":"잘렸"},{"id":"s2136","ko":"사표"},{"id":"s2137","ko":"이직"},{"id":"s2138","ko":"취직"},{"id":"s2139","ko":"합격"},{"id":"s2140","ko":"승진"},{"id":"s2141","ko":"일의 변화"},{"id":"s2142","ko":"직업·자리의 변동을 뜻해요. 합격·승진은 길하고 해고는 오히려 자리 이동으로 봐요."},{"id":"s2143","ko":"내 자리에 대한 불안이나 새 도전에 대한 기대가 함께 나타나요."},{"id":"s2144","ko":"복권"},{"id":"s2145","ko":"당첨"},{"id":"s2146","ko":"로또"},{"id":"s2147","ko":"횡재"},{"id":"s2148","ko":"주웠"}]