[{"id":"s3521","ko":"모임이나 회의에서 역할을 정해요."},{"id":"s3522","ko":"승"},{"id":"s3523","ko":"차근차근 올라가기"},{"id":"s3524","ko":"바닥에서 한 계단씩 올라가요. 서두르지 않으면 높은 데까지 가요."},{"id":"s3525","ko":"다음 단계를 한 칸만 정해요."},{"id":"s3527","ko":"궁지에 몰린 느낌"},{"id":"s3528","ko":"말이 통하지 않고 지치기 쉬운 날이에요. 말을 아끼고 몸을 지키면 지나가요."},{"id":"s3529","ko":"변명하지 말고 쉬어요."},{"id":"s3530","ko":"정"},{"id":"s3531","ko":"우물처럼 꾸준히 퍼 주기"},{"id":"s3532","ko":"우물은 옮기지 않아도 늘 사람을 살려요. 근본을 지키고 꾸준히 가꾸세요."},{"id":"s3533","ko":"기본 업무를 점검해요."},{"id":"s3534","ko":"혁"},{"id":"s3535","ko":"바꿔야 하는 때"},{"id":"s3536","ko":"묵은 방식을 갈아엎을 때가 왔어요. 충분히 설득하고 바꾸면 믿음을 얻어요."},{"id":"s3537","ko":"낡은 방식 하나를 바꿔 봐요."},{"id":"s3539","ko":"새것을 끓여 내기"},{"id":"s3540","ko":"재료를 모아 새로운 것을 만드는 때예요. 좋은 사람, 좋은 재료를 쓰세요."},{"id":"s3541","ko":"새 프로젝트의 재료를 모아요."},{"id":"s3543","ko":"깜짝 놀랄 일"},{"id":"s3544","ko":"갑작스러운 일에 놀라지만 지나고 보면 큰 탈은 없어요. 침착하면 웃음으로 끝나요."},{"id":"s3545","ko":"놀라도 숨 한 번 쉬고 움직여요."},{"id":"s3546","ko":"간"},{"id":"s3547","ko":"멈추어 고요하기"},{"id":"s3548","ko":"멈출 때와 움직일 때를 아는 것이 지혜예요. 오늘은 멈추고 마음을 가라앉혀요."},{"id":"s3549","ko":"잠깐 멈추고 생각을 정리해요."},{"id":"s3550","ko":"점"},{"id":"s3551","ko":"천천히 한 걸음씩"},{"id":"s3552","ko":"차근차근 나아가야 오래 가요. 결혼·계약·진로처럼 큰 일에 맞는 속도예요."},{"id":"s3553","ko":"급하지 않게 한 단계씩 해요."},{"id":"s3554","ko":"귀매"},{"id":"s3555","ko":"서두르면 어긋나는 인연"},{"id":"s3556","ko":"앞서 나가는 마음이 오히려 일을 꼬이게 해요. 순서와 형식을 지키세요."},{"id":"s3557","ko":"약속·계약의 순서를 확인해요."},{"id":"s3558","ko":"풍"},{"id":"s3559","ko":"한창 풍성한 때"},{"id":"s3560","ko":"가장 풍성하고 밝은 때예요. 해가 정오를 지나면 기우니 지금 충분히 누리고 대비하세요."},{"id":"s3561","ko":"지금 잘되는 일을 점검해 둬요."},{"id":"s3562","ko":"려"},{"id":"s3563","ko":"길 위의 나그네"}]