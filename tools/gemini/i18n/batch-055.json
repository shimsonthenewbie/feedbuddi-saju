[{"id":"s2358","ko":"헤어진"},{"id":"s2360","ko":"지난 인연이 마음에 남아 있다는 뜻으로 봐요."},{"id":"s2361","ko":"그 사람 자체보다 그때의 감정이나 지금 부족한 것을 비추는 경우가 많아요."},{"id":"s2362","ko":"돈을"},{"id":"s2363","ko":"돈이"},{"id":"s2364","ko":"지폐"},{"id":"s2365","ko":"현금"},{"id":"s2366","ko":"금반지"},{"id":"s2367","ko":"금붙이"},{"id":"s2368","ko":"금덩이"},{"id":"s2369","ko":"보석"},{"id":"s2371","ko":"돈·금붙이"},{"id":"s2372","ko":"재물이 들어오거나 기회가 온다는 길한 꿈으로 봐요."},{"id":"s2373","ko":"가치를 인정받고 싶은 마음, 경제적 걱정을 나타내기도 해요."},{"id":"s2375","ko":"_사자"},{"id":"s2376","ko":"_곰"},{"id":"s2377","ko":"맹수"},{"id":"s2378","ko":"큰 힘이나 권위(귀인)를 만나는 꿈으로 보기도 해요."},{"id":"s2379","ko":"위협으로 느꼈다면 압박감, 친근했다면 내 안의 힘을 뜻해요."},{"id":"s2380","ko":"_피가"},{"id":"s2381","ko":"_피를"},{"id":"s2382","ko":"출혈"},{"id":"s2383","ko":"상처"},{"id":"s2384","ko":"피·상처"},{"id":"s2385","ko":"재물이나 큰 변화와 연결해서 보기도 해요."},{"id":"s2386","ko":"마음의 상처, 에너지 소진을 알리는 신호일 수 있어요."},{"id":"s2387","ko":"_꽃"},{"id":"s2389","ko":"꽃이 활짝 피면 기쁜 일과 좋은 인연의 신호로 봐요."},{"id":"s2390","ko":"인정받고 싶은 마음과 기대감을 보여 줘요."},{"id":"s2393","ko":"지켜보는 눈, 영리한 사람, 구설을 조심하라는 뜻으로 보기도 해요."},{"id":"s2394","ko":"독립성과 위로, 혹은 예민해진 감각을 뜻해요."},{"id":"s2396","ko":"_개가"},{"id":"s2397","ko":"_개를"},{"id":"s2399","ko":"충직한 사람과 도움, 때로는 시비를 뜻해요."},{"id":"s2400","ko":"신뢰와 보호받고 싶은 마음을 나타내요."},{"id":"s2401","ko":"지진"},{"id":"s2402","ko":"무너"},{"id":"s2403","ko":"붕괴"},{"id":"s2404","ko":"무너지는 것"},{"id":"s2405","ko":"크게 흔들리는 일이 정리되는 신호로 보기도 해요."}]