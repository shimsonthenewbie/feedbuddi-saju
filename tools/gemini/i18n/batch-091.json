[{"id":"s4156","ko":"입춘 무렵,"},{"id":"s4157","ko":"봄이 오는 달,"},{"id":"s4158","ko":"꽃 피는 달,"},{"id":"s4159","ko":"초여름,"},{"id":"s4160","ko":"한여름 문턱,"},{"id":"s4161","ko":"무더운 달,"},{"id":"s4162","ko":"더위가 꺾이는 달,"},{"id":"s4163","ko":"가을 문턱,"},{"id":"s4164","ko":"단풍 드는 달,"},{"id":"s4165","ko":"찬 바람 부는 달,"},{"id":"s4166","ko":"한 해 끝자락,"},{"id":"s4167","ko":"반가운 소식이 들어와요."},{"id":"s4168","ko":"미뤄 둔 연락이나 제안을 이 달에 꺼내 보세요."},{"id":"s4169","ko":"하던 일이 술술 풀려요."},{"id":"s4170","ko":"속도를 내도 좋은 달이에요. 중요한 일을 이 달에 두세요."},{"id":"s4171","ko":"사람 복이 있는 달이에요."},{"id":"s4172","ko":"모임·소개에 나가 보세요. 인연이 일로 이어져요."},{"id":"s4173","ko":"노력한 만큼 인정받아요."},{"id":"s4174","ko":"결과물을 눈에 보이게 정리해 내보이세요."},{"id":"s4175","ko":"마음이 가벼워지는 달이에요."},{"id":"s4176","ko":"새로운 것을 시작하기에 부담이 적어요."},{"id":"s4177","ko":"큰 변화는 없고 평온해요."},{"id":"s4178","ko":"일상 리듬을 지키는 것이 가장 좋은 선택이에요."},{"id":"s4179","ko":"해야 할 일을 차근차근 하는 달이에요."},{"id":"s4180","ko":"미뤄 둔 정리와 점검을 하기에 좋아요."},{"id":"s4181","ko":"기복 없이 지나가요."},{"id":"s4182","ko":"다음 달을 위한 준비에 힘을 쓰세요."},{"id":"s4183","ko":"작은 일들이 쌓여요."},{"id":"s4184","ko":"사소한 약속부터 성실히 지키세요."},{"id":"s4185","ko":"조용하지만 속은 단단해져요."},{"id":"s4186","ko":"공부나 기술 같은 눈에 안 띄는 투자에 어울려요."},{"id":"s4187","ko":"말이 엇갈리기 쉬워요."},{"id":"s4188","ko":"중요한 이야기는 글로 남기고, 감정이 올라올 때는 하루 뒤에 답하세요."},{"id":"s4189","ko":"몸이 먼저 지쳐요."},{"id":"s4190","ko":"일정을 줄이고 잠을 우선하세요. 큰 결정은 다음 달로 미루세요."},{"id":"s4191","ko":"돈이 새기 쉬운 달이에요."},{"id":"s4192","ko":"충동구매와 보증·빌려주기는 피하세요."},{"id":"s4193","ko":"뜻대로 안 돼도 조급해하지 마세요."},{"id":"s4194","ko":"막힌 일은 잠시 두고 다른 길을 찾으세요."},{"id":"s4195","ko":"사람 사이에서 오해가 생길 수 있어요."}]