[{"id":"s3435","ko":"다시 돌아오는 힘"},{"id":"s3436","ko":"바닥을 찍고 다시 올라오는 첫 신호가 있어요. 작은 회복을 소중히 키워요."},{"id":"s3437","ko":"쉬었던 습관 하나를 다시 시작해요."},{"id":"s3438","ko":"무망"},{"id":"s3439","ko":"꾸밈없이 순수하게"},{"id":"s3440","ko":"계산 없이 솔직한 쪽이 맞아요. 욕심내서 얻으려 하면 오히려 탈이 나요."},{"id":"s3441","ko":"있는 그대로 말해요."},{"id":"s3442","ko":"대축"},{"id":"s3443","ko":"크게 쌓아 두기"},{"id":"s3444","ko":"실력과 힘을 크게 모으는 때예요. 지금 쌓는 공부가 나중에 큰 힘이 돼요."},{"id":"s3445","ko":"배움에 시간을 써요."},{"id":"s3447","ko":"입과 먹는 것 돌보기"},{"id":"s3448","ko":"무엇을 먹고 무슨 말을 하는지가 중요한 날이에요. 몸과 말을 건강하게 기르세요."},{"id":"s3449","ko":"식사를 제때 하고 말을 아껴요."},{"id":"s3450","ko":"대과"},{"id":"s3451","ko":"짐이 너무 무거울 때"},{"id":"s3452","ko":"기둥이 휠 만큼 부담이 커요. 혼자 버티지 말고 짐을 나누거나 덜어요."},{"id":"s3453","ko":"해야 할 일 하나를 내려놓아요."},{"id":"s3455","ko":"거듭된 물길"},{"id":"s3456","ko":"어려움이 겹쳐도 물은 낮은 데로 흘러 길을 만들어요. 정성을 다하면 지나가요."},{"id":"s3457","ko":"걱정은 적고 한 걸음씩 가요."},{"id":"s3459","ko":"밝게 붙어 빛나기"},{"id":"s3460","ko":"밝은 곳에 의지하면 환해져요. 좋은 사람·좋은 목표에 붙어 가세요."},{"id":"s3461","ko":"존경하는 사람의 방식을 따라 해 봐요."},{"id":"s3462","ko":"함"},{"id":"s3463","ko":"마음이 서로 통하는 날"},{"id":"s3464","ko":"마음이 움직이고 끌림이 생겨요. 진심으로 다가가면 통해요."},{"id":"s3465","ko":"마음을 솔직하게 표현해요."},{"id":"s3466","ko":"항"},{"id":"s3467","ko":"꾸준함이 힘"},{"id":"s3468","ko":"한결같이 이어 가는 것이 가장 큰 힘이에요. 변덕은 줄이고 리듬을 지켜요."},{"id":"s3469","ko":"매일 하는 습관을 오늘도 해요."},{"id":"s3471","ko":"물러나는 지혜"},{"id":"s3472","ko":"지금은 맞서기보다 한 발 물러서는 쪽이 이득이에요. 피하는 것도 용기예요."},{"id":"s3473","ko":"굳이 이기려 하지 말아요."},{"id":"s3474","ko":"대장"},{"id":"s3475","ko":"힘이 센 날"},{"id":"s3476","ko":"기세가 좋지만 힘만 믿으면 부딪혀요. 옳은 방향에만 쓰세요."},{"id":"s3477","ko":"힘 쓸 일은 정중하게 해요."},{"id":"s3478","ko":"진"}]