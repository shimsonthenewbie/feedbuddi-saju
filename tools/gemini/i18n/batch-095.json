[{"id":"s4324","ko":"배우자 복과 안정된 생활을 돕는 기운이에요."},{"id":"s4326","ko":"올해는 흐름이 받쳐 주는 해예요. 기회의 달을 놓치지 말고 움직이세요."},{"id":"s4328","ko":"큰 탈 없이 무난한 해예요. 준비한 만큼 결과가 따라와요."},{"id":"s4330","ko":"좋은 달과 무거운 달이 섞인 해예요. 시기를 고르는 게 중요해요."},{"id":"s4332","ko":"조금 무거운 해예요. 무리하지 말고 기회의 달에 힘을 모아요."},{"id":"s4334","ko":"변화와 부딪힘이 큰 해예요. 큰 결정은 신중하게, 기회의 달에 움직여요."},{"id":"s4340","ko":"태어난 해의 기운과 올해가 부딪혀 주변 환경과 인간관계에 변화가 많아요."},{"id":"s4341","ko":"직장·사회생활 쪽이 흔들릴 수 있어요."},{"id":"s4342","ko":"생활 터전과 가까운 관계가 흔들릴 수 있어요."},{"id":"s4343","ko":"마음이 꼬이거나 오해가 생기기 쉬워요."},{"id":"s4344","ko":"인연과 협력의 기회도 들어와요."},{"id":"s4345","ko":"${y}년 총운"},{"id":"s4346","ko":"올해 조심할 것"},{"id":"s4347","ko":"크게 부딪히는 곳이 보이지 않아요."},{"id":"s4348","ko":"올해 들어오는 살"},{"id":"s4349","ko":"타고난 살·귀인"},{"id":"s4350","ko":"지난 3개월"},{"id":"s4351","ko":"먼저 지나온 시기를 볼게요. 이런 흐름이었어요."},{"id":"s4352","ko":"이번 달"},{"id":"s4354","ko":"앞으로는 이렇게 가는 게 좋아요."},{"id":"s4355","ko":"달별로 보기"},{"id":"s4356","ko":"접기"},{"id":"s4357","ko":"큰 변화나 정리가 있었을 수 있는 시기였어요."},{"id":"s4358","ko":"마음이 예민하고 지치기 쉬운 시기였어요."},{"id":"s4359","ko":"일과 책임이 무겁게 느껴졌을 시기였어요."},{"id":"s4360","ko":"시작하거나 부탁하기 좋은 시기였어요."},{"id":"s4361","ko":"비교적 평탄하게 지나간 시기였어요."},{"id":"s4362","ko":"지난 시기는 흐름만 짚은 거예요. 실제와 다를 수 있어요."},{"id":"s4363","ko":"좋은 기운"},{"id":"s4364","ko":"조심할 기운"},{"id":"s4366","ko":"년주"},{"id":"s4368","ko":"월주"},{"id":"s4370","ko":"일주"},{"id":"s4372","ko":"귀문"},{"id":"s4373","ko":"대운"},{"id":"s4375","ko":"비견"},{"id":"s4376","ko":"겁재"},{"id":"s4377","ko":"식신"},{"id":"s4378","ko":"상관"},{"id":"s4379","ko":"편재"}]