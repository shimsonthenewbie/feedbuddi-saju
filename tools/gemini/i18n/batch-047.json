[{"id":"s2027","ko":"옷을"},{"id":"s2028","ko":"옷이"},{"id":"s2029","ko":"드레스"},{"id":"s2030","ko":"교복"},{"id":"s2031","ko":"양복"},{"id":"s2032","ko":"신발"},{"id":"s2033","ko":"구두"},{"id":"s2034","ko":"옷·신발"},{"id":"s2035","ko":"새 옷은 새 출발과 기쁜 일, 더러운 옷이나 잃어버린 신발은 마음이 쓰이는 일을 뜻해요."},{"id":"s2036","ko":"내가 사회에서 보여 주는 모습, 역할에 대한 감각이에요."},{"id":"s2037","ko":"지갑"},{"id":"s2038","ko":"가방"},{"id":"s2039","ko":"잃어버"},{"id":"s2040","ko":"분실"},{"id":"s2041","ko":"도둑맞"},{"id":"s2042","ko":"잃어버림"},{"id":"s2043","ko":"소중한 것을 놓칠까 하는 걱정이지만, 잃어버리고 나서 홀가분했다면 비우는 시기로 봐요."},{"id":"s2044","ko":"내가 가진 것, 정체성에 대한 불안이나 책임을 덜고 싶은 마음이에요."},{"id":"s2045","ko":"음식"},{"id":"s2046","ko":"밥을"},{"id":"s2047","ko":"먹었"},{"id":"s2048","ko":"먹는"},{"id":"s2049","ko":"고기"},{"id":"s2050","ko":"과자"},{"id":"s2051","ko":"케이크"},{"id":"s2052","ko":"술을"},{"id":"s2053","ko":"술이"},{"id":"s2054","ko":"음식·먹는 꿈"},{"id":"s2055","ko":"맛있게 먹으면 재물과 기쁨이, 체하거나 맛이 없으면 근심이 있다고 봐요."},{"id":"s2056","ko":"채우고 싶은 욕구, 위로나 애정에 대한 갈증을 보여 줘요."},{"id":"s2057","ko":"책이"},{"id":"s2058","ko":"책을"},{"id":"s2059","ko":"편지"},{"id":"s2060","ko":"글을"},{"id":"s2061","ko":"문서"},{"id":"s2062","ko":"계약서"},{"id":"s2063","ko":"글·문서"},{"id":"s2064","ko":"문서·계약과 소식을 뜻해요. 좋은 내용이면 좋은 소식, 찢어지거나 못 읽으면 지체를 뜻해요."},{"id":"s2065","ko":"전하고 싶은 말, 정리되지 않은 생각이 글로 나타나요."},{"id":"s2066","ko":"비행기"}]