[{"id":"s4380","ko":"정재"},{"id":"s4381","ko":"편관"},{"id":"s4382","ko":"정관"},{"id":"s4383","ko":"편인"},{"id":"s4384","ko":"정인"},{"id":"s4398","ko":"용용사주"},{"id":"s4399","ko":"용하디 용한 사주, 용용이가 봐 드려요\n생년월일만 넣으면 오늘의 운세와 고민 상담까지"},{"id":"s4401","ko":"홈"},{"id":"s4402","ko":"무료 사주 맛보기"},{"id":"s4403","ko":"관상 (사진으로 보기)"},{"id":"s4404","ko":"얼굴로 보는 관상"},{"id":"s4405","ko":"정면 사진 한 장이면 돼요. 사진은 내 기기 안에서만 분석하고 서버로 보내지 않아요."},{"id":"s4406","ko":"밝은 곳에서 정면으로"},{"id":"s4407","ko":"머리카락은 이마가 보이게 넘기기"},{"id":"s4408","ko":"안경·마스크·모자는 벗기"},{"id":"s4409","ko":"무표정에 가깝게"},{"id":"s4410","ko":"얼굴에서 점을 하나씩 찾는 중"},{"id":"s4411","ko":"눈 사이를 재어 기준을 잡는 중"},{"id":"s4412","ko":"다섯 기운의 비율을 읽는 중"},{"id":"s4413","ko":"이마 상단"},{"id":"s4414","ko":"눈썹 사이"},{"id":"s4415","ko":"코 아래"},{"id":"s4416","ko":"턱끝"},{"id":"s4417","ko":"오행 얼굴형"},{"id":"s4418","ko":"${e}의 성향이 함께 섞여 있어요. 한 가지 색으로만 설명되지 않는 얼굴이에요."},{"id":"s4419","ko":"내 관상 카드 공유하기"},{"id":"s4420","ko":"카드 이미지를 저장했어요. 친구에게 보내 보세요."},{"id":"s4421","ko":"사진을 올리기 전에 확인해 주세요"},{"id":"s4422","ko":"아래 내용에 모두 동의해요"},{"id":"s4423","ko":"분석이 오래 걸려요. 인터넷 연결을 확인하고 다시 시도해 주세요."},{"id":"s4424","ko":"사진은 이 기기 안에서만 분석하고, 서버로 보내거나 저장하지 않는다는 점을 확인했어요."},{"id":"s4425","ko":"내 사진이거나, 사진 속 사람의 허락을 받은 사진이에요. (만 14세 미만은 보호자 동의가 필요해요)"},{"id":"s4426","ko":"관상은 재미로 보는 경향 풀이이고, 성격·능력을 단정하지 않는다는 점을 알아요."},{"id":"s4427","ko":"동의하고 사진 고르기"},{"id":"s4428","ko":"취소"},{"id":"s4429","ko":"개인정보 처리방침"},{"id":"s4430","ko":"이용약관"},{"id":"s4431","ko":"돌아가기"},{"id":"s4432","ko":"카메라로 찍기"},{"id":"s4433","ko":"앨범에서 고르기"}]